# -------------------------------
# FastAPI server
# -------------------------------
APP_NAME=Blueprint4FastAPI API
APP_ENV=local
LOG_LEVEL=INFO
APP_PORT=8000
APP_BASE_URL=http://localhost:5173
SWAGGER_ENABLED=true
METRICS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost

# -------------------------------
# Observability / Tracing
# -------------------------------
TRACING_ENABLED=false
OTEL_SERVICE_NAME=blueprint4fastapi-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=10
OTEL_TRACE_SAMPLE_RATIO=1.0

# -------------------------------
# Auth
# -------------------------------
LOGIN_ENABLED=true
PASSWORD_AUTH_ENABLED=false
# If set to false, OAUTH_ENABLED and EMAIL_ENABLED are forced off at runtime.
# Used when LOGIN_ENABLED=false (frontend bootstraps this account from /config).
# Only email and name are configurable; id/profile_image/is_verified are fixed internally.
BOOTSTRAP_USER_EMAIL=demo@example.com
BOOTSTRAP_USER_NAME=Demo User
SECRET_KEY=CHANGE_ME_FOR_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
LOGIN_FAILED_LIMIT=5
LOGIN_LOCKED_MINUTES=5

# -------------------------------
# Database
# DB_DRIVER options:
#   sqlite+aiosqlite (default, easy local start)
#   postgresql+asyncpg (docker/postgres)
# -------------------------------
DB_DRIVER=sqlite+aiosqlite
DB_NAME=template.db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# -------------------------------
# Redis
# REDIS_IN_MEMORY=true lets the API run without docker/external Redis.
# Turn this off when using real Redis.
# -------------------------------
REDIS_IN_MEMORY=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# -------------------------------
# Email / SMTP
# EMAIL_ENABLED=false keeps mail sender disabled.
# -------------------------------
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@example.com
EMAIL_BRAND_NAME=Blueprint4FastAPI
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
SMTP_VALIDATE_ON_STARTUP=true
EMAIL_QUEUE_BLOCK_TIMEOUT_SECONDS=2
EMAIL_QUEUE_MAX_RETRIES=3
EMAIL_QUEUE_RETRY_DELAY_SECONDS=2

# -------------------------------
# OAuth
# OAUTH_ALLOWED_PROVIDERS supports: google,github
# -------------------------------
OAUTH_ENABLED=false
OAUTH_ALLOWED_PROVIDERS=github
OAUTH_STATE_EXPIRE_MINUTES=10
# redirect: existing frontend redirect flow. json: backend-only/dev OAuth verification response.
OAUTH_CALLBACK_RESPONSE_MODE=redirect
OAUTH_FRONTEND_SUCCESS_PATH=/dashboard
OAUTH_FRONTEND_FAILURE_PATH=/login

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
OAUTH_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
OAUTH_GITHUB_USERINFO_URL=https://api.github.com/user
# GitHub App slug used to build https://github.com/apps/{slug}/installations/new.
GITHUB_APP_SLUG=
# GitHub App webhook secret for POST /api/v1/webhooks/github.
# Configure the GitHub App Webhook URL as: ${APP_BASE_URL}/api/v1/webhooks/github
GITHUB_WEBHOOK_SECRET=

# -------------------------------
# Realtime / SSE
# -------------------------------
SSE_HEARTBEAT_SECONDS=20
SSE_RETRY_MILLIS=5000
